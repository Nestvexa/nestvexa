{
  "name": "@nestvexa/uploads",
  "version": "0.1.0-alpha.0",
  "description": "Opt-in NestJS upload pipeline: streaming limits, magic-byte validation, temporary tokens, chunked uploads, local/S3-compatible storage and safe downloads",
  "license": "MIT",
  "author": "Nestvexa contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nestvexa/nestvexa.git",
    "directory": "packages/uploads"
  },
  "homepage": "https://github.com/Nestvexa/nestvexa/tree/main/packages/uploads#readme",
  "bugs": {
    "url": "https://github.com/Nestvexa/nestvexa/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js",
      "default": "./dist/browser/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json",
    "test": "vitest run ../../tests/uploads-validation.test.ts ../../tests/uploads-http.test.ts ../../tests/uploads-limits.test.ts ../../tests/uploads-s3.test.ts ../../tests/uploads-browser.test.ts",
    "lint": "eslint src"
  },
  "dependencies": {
    "busboy": "1.6.0"
  },
  "devDependencies": {
    "@types/busboy": "1.5.5"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
