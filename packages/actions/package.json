{
  "name": "@nestvexa/actions",
  "version": "0.1.0-alpha.0",
  "description": "Authorization-first NestJS server actions with explicit registration and a generated typed browser client",
  "license": "MIT",
  "author": "Nestvexa contributors",
  "maintainers": [
    {
      "name": "Nestvexa",
      "url": "https://github.com/Nestvexa"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nestvexa/nestvexa.git",
    "directory": "packages/actions"
  },
  "homepage": "https://github.com/Nestvexa/nestvexa/tree/main/packages/actions#readme",
  "bugs": {
    "url": "https://github.com/Nestvexa/nestvexa/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./codegen": {
      "types": "./dist/codegen/index.d.ts",
      "import": "./dist/codegen/index.js",
      "default": "./dist/codegen/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "nestvexa-actions-codegen": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. tests/actions-",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
