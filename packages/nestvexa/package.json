{
  "name": "nestvexa",
  "version": "0.1.0-alpha.0",
  "description": "NestJS-native full-stack rendering: default Handlebars distribution",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./assets": {
      "types": "./dist/assets.d.ts",
      "import": "./dist/assets.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run ../../tests/integration.test.ts ../../tests/assets.test.ts",
    "lint": "eslint src"
  },
  "dependencies": {
    "@nestvexa/core": "workspace:*",
    "@nestvexa/views": "workspace:*",
    "@nestvexa/engine-hbs": "workspace:*",
    "@nestvexa/client": "workspace:*",
    "@nestvexa/alpine": "workspace:*",
    "@alpinejs/csp": "3.17.5"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
