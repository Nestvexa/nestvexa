{
  "name": "@nestvexa/vue",
  "version": "0.1.0-alpha.0",
  "description": "Official @inertiajs/vue3 client and SSR entry helpers for Nestvexa Inertia hosts built with Vite",
  "license": "MIT",
  "author": "Nestvexa contributors",
  "maintainers": [
    {
      "name": "Nestvexa",
      "url": "https://github.com/Nestvexa"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nestvexa/nestvexa.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/Nestvexa/nestvexa/tree/main/packages/vue#readme",
  "bugs": {
    "url": "https://github.com/Nestvexa/nestvexa/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ssr": {
      "types": "./dist/ssr.d.ts",
      "import": "./dist/ssr.js",
      "default": "./dist/ssr.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. tests/vue-adapter",
    "lint": "eslint src"
  },
  "dependencies": {
    "@nestvexa/vite": "workspace:*"
  },
  "peerDependencies": {
    "@inertiajs/core": "^3.10.0",
    "@inertiajs/vue3": "^3.10.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@inertiajs/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@inertiajs/core": "3.10.0",
    "@inertiajs/vue3": "3.10.0",
    "vue": "3.5.44"
  }
}
