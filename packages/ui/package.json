{
  "name": "@nestvexa/ui",
  "version": "0.1.0-alpha.0",
  "description": "Optional unstyled accessible UI primitives: HBS/Live helpers, React, Vue and Svelte wrappers on one markup contract, a keyboard browser module and an optional theme",
  "license": "MIT",
  "author": "Nestvexa contributors",
  "maintainers": [
    {
      "name": "Nestvexa",
      "url": "https://github.com/Nestvexa"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nestvexa/nestvexa.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/Nestvexa/nestvexa/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/Nestvexa/nestvexa/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./markup": {
      "types": "./dist/markup.d.ts",
      "import": "./dist/markup.js",
      "default": "./dist/markup.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js",
      "default": "./dist/browser/index.js"
    },
    "./react": {
      "types": "./dist/adapters/react.d.ts",
      "import": "./dist/adapters/react.js",
      "default": "./dist/adapters/react.js"
    },
    "./vue": {
      "types": "./dist/adapters/vue.d.ts",
      "import": "./dist/adapters/vue.js",
      "default": "./dist/adapters/vue.js"
    },
    "./svelte": {
      "types": "./svelte/index.d.ts",
      "svelte": "./svelte/index.js",
      "import": "./svelte/index.js",
      "default": "./svelte/index.js"
    },
    "./theme.css": "./theme/theme.css",
    "./tokens.css": "./theme/tokens.css"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "svelte",
    "theme",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json && tsc -p tsconfig.adapters.json",
    "test": "vitest run --root ../.. tests/ui-",
    "lint": "eslint src"
  },
  "dependencies": {
    "@nestvexa/views": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "svelte": "^5.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "svelte": "5.57.3",
    "vue": "3.5.44"
  }
}
