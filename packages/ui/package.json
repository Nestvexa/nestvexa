{
  "name": "@nestvexa/ui",
  "version": "0.1.0-alpha.0",
  "description": "Optional unstyled accessible HBS/Live UI primitives with a keyboard browser module and optional theme",
  "license": "MIT",
  "author": "Nestvexa contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nestvexa/nestvexa.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/Nestvexa/nestvexa/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/Nestvexa/nestvexa/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./theme.css": "./theme/theme.css"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "theme",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json",
    "lint": "eslint src"
  },
  "dependencies": {
    "@nestvexa/views": "workspace:*"
  }
}
