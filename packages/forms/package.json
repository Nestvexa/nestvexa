{
  "name": "@nestvexa/forms",
  "version": "0.1.0-alpha.0",
  "description": "Hardened form validation for NestJS and Nestvexa Live: Zod and class-validator adapters, accessible error bags, wizards, drafts and a no-JS POST fallback",
  "license": "MIT",
  "author": "Nestvexa contributors",
  "maintainers": [
    {
      "name": "Nestvexa",
      "url": "https://github.com/Nestvexa"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nestvexa/nestvexa.git",
    "directory": "packages/forms"
  },
  "homepage": "https://github.com/Nestvexa/nestvexa/tree/main/packages/forms#readme",
  "bugs": {
    "url": "https://github.com/Nestvexa/nestvexa/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./live": {
      "types": "./dist/live.d.ts",
      "import": "./dist/live.js",
      "default": "./dist/live.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. tests/forms-",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestvexa/live": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@nestvexa/live": {
      "optional": true
    },
    "class-transformer": {
      "optional": true
    },
    "class-validator": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestvexa/live": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "zod": "4.6.7"
  }
}
