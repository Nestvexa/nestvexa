{
  "name": "@nestvexa/forms",
  "version": "0.1.0-alpha.0",
  "description": "Hardened form validation for NestJS and Nestvexa Live: Zod and class-validator adapters, accessible error bags, wizards, drafts and a no-JS POST fallback",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./live": {
      "types": "./dist/live.d.ts",
      "import": "./dist/live.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run ../../tests/forms-adapters.test.ts ../../tests/forms-hardening.test.ts ../../tests/forms-state.test.ts ../../tests/forms-progressive.test.ts ../../tests/forms-live.test.ts",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestvexa/live": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@nestvexa/live": {
      "optional": true
    },
    "class-transformer": {
      "optional": true
    },
    "class-validator": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestvexa/live": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "zod": "4.6.7"
  }
}
