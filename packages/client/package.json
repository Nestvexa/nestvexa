{
  "name": "@nestvexa/client",
  "version": "0.1.0-alpha.0",
  "description": "Browser-only Nestvexa Live protocol client",
  "license": "MIT",
  "author": "Nestvexa contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nestvexa/nestvexa.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/Nestvexa/nestvexa/tree/main/packages/client#readme",
  "bugs": {
    "url": "https://github.com/Nestvexa/nestvexa/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/live-realtime.js",
    "dist/live-realtime.js.map",
    "dist/live-sort.js",
    "dist/live-sort.js.map",
    "dist/live-stream.js",
    "dist/live-stream.js.map",
    "dist/live-upload.js",
    "dist/live-upload.js.map",
    "dist/*.d.ts",
    "dist/*.d.ts.map",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly && node ../../scripts/build-client.mjs",
    "test": "vitest run ../../tests/client.test.ts ../../tests/client-focus.test.ts",
    "lint": "eslint src"
  }
}
