{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Nestvexa Design System",
  "version": "1.0.0-draft",
  "color": {
    "brand": {
      "primary": "#0E9F79",
      "hover": "#0B765D",
      "pressed": "#065942",
      "subtle": "#DFF5EC",
      "pale": "#F0FAF6"
    },
    "neutral": {
      "ink": "#111C25",
      "canvas": "#F8FAF8",
      "white": "#FFFFFF",
      "muted": "#61717A",
      "border": "#D7E2DD"
    },
    "semantic": {
      "success": "#0B765D",
      "info": "#2457AE",
      "warning": "#A96312",
      "error": "#C53442"
    },
    "dark": {
      "background": "#0C151B",
      "surface": "#16232C",
      "border": "#2D4248"
    }
  },
  "font": {
    "display": "Inter Display, Inter, sans-serif",
    "body": "Inter, system-ui, sans-serif",
    "mono": "JetBrains Mono, IBM Plex Mono, ui-monospace, monospace"
  },
  "type": {
    "xs": "12px",
    "sm": "14px",
    "base": "16px",
    "lg": "18px",
    "xl": "20px",
    "2xl": "24px",
    "3xl": "30px",
    "4xl": "36px",
    "5xl": "48px"
  },
  "spacing": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "radius": {
    "sm": "6px",
    "md": "10px",
    "lg": "14px",
    "xl": "18px",
    "pill": "999px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(17,28,37,.08)",
    "md": "0 8px 24px rgba(17,28,37,.08)"
  },
  "motion": {
    "fast": "120ms",
    "base": "180ms",
    "slow": "280ms",
    "easing": "cubic-bezier(.2,.7,.2,1)"
  },
  "layout": {
    "contentMax": "1200px",
    "docsSidebar": "248px",
    "header": "64px"
  }
}
