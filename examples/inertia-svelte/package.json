{
  "name": "@nestvexa/example-inertia-svelte",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && svelte-check --tsconfig client/tsconfig.json --fail-on-warnings && vite build && vite build --ssr client/ssr.ts --outDir dist/ssr",
    "dev": "tsx src/main.ts --dev",
    "start": "node dist/main.js",
    "start:e2e": "node dist/main.js --test-controls",
    "start:csr": "node dist/main.js --test-controls --client-only"
  },
  "dependencies": {
    "@inertiajs/svelte": "3.10.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestvexa/forms": "workspace:*",
    "@nestvexa/inertia": "workspace:*",
    "@nestvexa/svelte": "workspace:*",
    "@nestvexa/uploads": "workspace:*",
    "@nestvexa/vite": "workspace:*",
    "express-session": "1.19.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@inertiajs/core": "3.10.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/express-session": "1.19.0",
    "svelte-check": "4.7.8",
    "tsx": "4.23.15",
    "vite": "8.3.5"
  }
}
