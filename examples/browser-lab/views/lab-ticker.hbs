<section aria-label="Ticker" nv:poll.1s="tick">
  <p>Ticks: <output id="ticks">{{ticks}}</output></p>
  <p>Clicks: <output id="clicks">{{clicks}}</output></p>
  <button type="button" id="click" nv:click="click">Click</button>
  <p id="offline-banner" role="status" nv:offline>You are offline.</p>
</section>
