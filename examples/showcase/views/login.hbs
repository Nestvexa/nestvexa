<h1>{{title}}</h1>
{{#if summary.hasErrors}}
<div
  class="summary"
  id="login-summary"
  role="alert"
  aria-labelledby="login-summary-title"
>
  <h2 id="login-summary-title">{{summary.title}}</h2>
  <ul>
    {{#each summary.items}}
    <li>
      {{#if href}}<a href="{{href}}">{{label}}: {{message}}</a
      >{{else}}{{message}}{{/if}}
    </li>
    {{/each}}
  </ul>
</div>
{{/if}}
<form id="login-form" method="post" action="/login" novalidate>
  <input type="hidden" name="_csrf" value="{{csrf}}" />
  <label for="{{fields.email.id}}">{{t "login.email"}}</label>
  <input
    id="{{fields.email.id}}"
    name="email"
    type="email"
    value="{{old.email}}"
    autocomplete="username"
    maxlength="254"
    required
    aria-invalid="{{fields.email.ariaInvalid}}"
  />
  <label for="{{fields.password.id}}">{{t "login.password"}}</label>
  <input
    id="{{fields.password.id}}"
    name="password"
    type="password"
    autocomplete="current-password"
    maxlength="128"
    required
    aria-invalid="{{fields.password.ariaInvalid}}"
  />
  <button type="submit">{{t "login.submit"}}</button>
</form>
<h2>{{t "login.demoHeading"}}</h2>
<p>
  {{t "login.demoPassword"}}
  <code>showcase-demo-2026</code>. {{t "login.demoWarning"}}
</p>
<ul id="demo-accounts">
  {{#each accounts}}
  <li><code>{{email}}</code>: {{workspace}} {{role}}</li>
  {{/each}}
</ul>
