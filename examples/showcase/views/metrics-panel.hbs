<section aria-labelledby="metrics-heading" class="card">
  <h2 id="metrics-heading">{{t "metrics.heading"}}</h2>
  <p id="metrics-notice" class="notice" role="status" aria-live="polite">
    {{noticeText}}
  </p>
  <ul class="tiles" aria-label="{{t 'metrics.tiles'}}">
    <li class="tile">
      {{t "metrics.deployments"}}
      <output id="metric-deployments">{{metrics.deployments}}</output>
    </li>
    <li class="tile">
      {{t "metrics.created"}}
      <output id="metric-created">{{metrics.created}}</output>
    </li>
    <li class="tile">
      {{t "metrics.completed"}}
      <output id="metric-completed">{{metrics.completed}}</output>
    </li>
  </ul>
  <p>
    {{t "metrics.latest"}} {{#if metrics.last}}
    <span id="metric-last" lang="en">{{metrics.last}}</span>
    {{else}}
    <span id="metric-last">{{t "metrics.nothing"}}</span>
    {{/if}}
  </p>
  <button
    type="button"
    id="log-deployment"
    nv:click="logDeployment"
    nv:loading.attr="disabled"
    nv:target="logDeployment"
  >
    {{t "metrics.log"}}
  </button>
  <span
    id="metrics-saving"
    class="loading"
    role="status"
    nv:loading=""
    nv:target="logDeployment"
    hidden
    >{{t "metrics.saving"}}</span
  >
  <h3>{{t "metrics.onlineHeading"}}</h3>
  <p>
    <output id="presence-count">{{onlineCount}}</output>
    {{t "metrics.presence"}}
    <span id="rendered-by">{{renderedBy}}</span>
  </p>
  <ul id="presence-list" aria-label="{{t 'metrics.onlineList'}}">
    {{#each online}}
    <li>{{this}}</li>
    {{/each}}
  </ul>
  <h3>{{t "metrics.inboxHeading"}}</h3>
  <ul id="inbox" aria-label="{{t 'metrics.inboxHeading'}}">
    {{#each inbox}}
    <li data-nv-key="inbox-{{id}}" lang="en">{{text}}</li>
    {{else}}
    <li id="inbox-empty">{{t "metrics.inboxEmpty"}}</li>
    {{/each}}
  </ul>
  {{#if inbox.length}}
  <button type="button" id="inbox-clear" nv:click="clearNotifications">
    {{t "metrics.inboxClear"}}
  </button>
  {{/if}}
  <p id="metrics-offline" nv:offline="" role="status" hidden>
    {{t "metrics.offline"}}
  </p>
</section>
