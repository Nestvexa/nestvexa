<h1>{{title}}</h1>
<p class="lead">{{t "home.lead"}}</p>
<section aria-labelledby="features-heading">
  <h2 id="features-heading">{{t "home.featuresHeading"}}</h2>
  <ul>
    <li>{{t "home.features.dashboard"}}</li>
    <li>{{t "home.features.board"}}</li>
    <li>{{t "home.features.profile"}}</li>
    <li>{{t "home.features.insights"}}</li>
    <li>{{t "home.features.mail"}}</li>
  </ul>
</section>
<section aria-labelledby="workspaces-heading">
  <h2 id="workspaces-heading">{{t "home.workspacesHeading"}}</h2>
  <ul id="workspace-list">
    {{#each workspaces}}
    <li><strong>{{name}}</strong>: <span lang="en">{{tagline}}</span></li>
    {{/each}}
  </ul>
</section>
{{#if signedIn}}
<p><a href="/app">{{t "home.openDashboard"}}</a></p>
{{else}}
<p><a href="/login" id="home-sign-in">{{t "home.signInDemo"}}</a></p>
{{/if}}
