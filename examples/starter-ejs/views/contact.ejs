<h1><%= title %></h1>
<p>
  An ordinary HTML form: it posts, the server validates, and the browser is
  redirected back (post/redirect/get). No JavaScript is involved.
</p>
<% if (sent) { %>
<p id="contact-sent" class="notice" role="status"><%= sent %></p>
<% } %>
<% if (Object.keys(errors).length) { %>
<div id="contact-errors" role="alert">
  <p>Please correct the highlighted fields.</p>
</div>
<% } %>
<form method="post" action="/contact" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrf %>" />
  <label for="contact-name">Name</label>
  <% if (errors.name) { %>
  <input
    id="contact-name"
    name="name"
    value="<%= values.name %>"
    maxlength="60"
    autocomplete="name"
    aria-invalid="true"
    aria-describedby="contact-name-error"
  />
  <p id="contact-name-error" class="error"><%= errors.name %></p>
  <% } else { %>
  <input
    id="contact-name"
    name="name"
    value="<%= values.name %>"
    maxlength="60"
    autocomplete="name"
  />
  <% } %>
  <label for="contact-message">Message</label>
  <% if (errors.message) { %>
  <textarea
    id="contact-message"
    name="message"
    rows="4"
    maxlength="500"
    aria-invalid="true"
    aria-describedby="contact-message-error"
  ><%= values.message %></textarea>
  <p id="contact-message-error" class="error"><%= errors.message %></p>
  <% } else { %>
  <textarea id="contact-message" name="message" rows="4" maxlength="500"><%= values.message %></textarea>
  <% } %>
  <p><button type="submit">Send message</button></p>
</form>
