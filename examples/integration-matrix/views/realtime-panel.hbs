<section aria-labelledby="feed-heading">
  <h2 id="feed-heading">Public activity feed</h2>
  <form nv:submit="post">
    <label for="realtime-draft">Message</label>
    <input
      id="realtime-draft"
      nv:model="draft"
      value="{{draft}}"
      maxlength="80"
    />
    <button type="submit">Post update</button>
  </form>
  <p>
    Posted from this browser: <output id="realtime-posted">{{posted}}</output>
  </p>
  <ul id="realtime-feed" aria-label="Activity feed" aria-live="polite">
    {{#each feed}}
    <li data-nv-key="feed-{{id}}">{{text}}</li>
    {{else}}
    <li id="realtime-feed-empty">No activity yet.</li>
    {{/each}}
  </ul>
  <h2>Operator alerts</h2>
  {{#if operator}}
  <button type="button" nv:click="raiseAlert">Raise alert</button>
  <ul id="realtime-alerts" aria-label="Operator alerts" aria-live="polite">
    {{#each alerts}}
    <li data-nv-key="alert-{{id}}">{{text}}</li>
    {{else}}
    <li>No alerts.</li>
    {{/each}}
  </ul>
  {{else}}
  <p id="realtime-restricted">
    Alerts are restricted to operators. This session is not subscribed to the
    alert channel.
  </p>
  {{/if}}
</section>
