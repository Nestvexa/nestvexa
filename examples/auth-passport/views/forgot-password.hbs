<h1>{{title}}</h1>
{{#if summary.hasErrors}}
<div
  id="form-summary"
  role="group"
  aria-labelledby="form-summary-title"
  tabindex="-1"
>
  <h2 id="form-summary-title">{{summary.title}}</h2>
  <ul>
    {{#each summary.items}}
    <li>{{message}}</li>
    {{/each}}
  </ul>
</div>
{{/if}}
<form id="forgot-form" method="post" action="/forgot-password" novalidate>
  <input type="hidden" name="_csrf" value="{{csrf}}" />
  <label for="{{fields.email.id}}">Email</label>
  <input
    id="{{fields.email.id}}"
    name="email"
    type="email"
    value="{{old.email}}"
    autocomplete="email"
    maxlength="254"
    required
    aria-invalid="{{fields.email.ariaInvalid}}"
  />
  <button type="submit">Send a reset link</button>
</form>
