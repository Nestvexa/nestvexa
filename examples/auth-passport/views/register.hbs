<h1>{{title}}</h1>
{{#if summary.hasErrors}}
<div
  id="form-summary"
  role="group"
  aria-labelledby="form-summary-title"
  tabindex="-1"
>
  <h2 id="form-summary-title">{{summary.title}}</h2>
  <ul>
    {{#each summary.items}}
    <li>{{message}}</li>
    {{/each}}
  </ul>
</div>
{{/if}}
<form id="register-form" method="post" action="/register" novalidate>
  <input type="hidden" name="_csrf" value="{{csrf}}" />
  <label for="{{fields.email.id}}">Email</label>
  <input
    id="{{fields.email.id}}"
    name="email"
    type="email"
    value="{{old.email}}"
    autocomplete="email"
    maxlength="254"
    required
    aria-invalid="{{fields.email.ariaInvalid}}"
  />
  <label for="{{fields.name.id}}">Name</label>
  <input
    id="{{fields.name.id}}"
    name="name"
    type="text"
    value="{{old.name}}"
    autocomplete="name"
    maxlength="60"
    required
    aria-invalid="{{fields.name.ariaInvalid}}"
  />
  <label for="{{fields.password.id}}">Password (12 to 128 characters)</label>
  <input
    id="{{fields.password.id}}"
    name="password"
    type="password"
    autocomplete="new-password"
    minlength="12"
    maxlength="128"
    required
    aria-invalid="{{fields.password.ariaInvalid}}"
  />
  <button type="submit">Create account</button>
</form>
