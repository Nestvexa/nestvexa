<h1>{{title}}</h1>
{{#if summary.hasErrors}}
<div
  id="form-summary"
  role="group"
  aria-labelledby="form-summary-title"
  tabindex="-1"
>
  <h2 id="form-summary-title">{{summary.title}}</h2>
  <ul>
    {{#each summary.items}}
    <li>{{message}}</li>
    {{/each}}
  </ul>
</div>
{{/if}} {{#if valid}}
<form id="reset-form" method="post" action="/reset-password" novalidate>
  <input type="hidden" name="_csrf" value="{{csrf}}" />
  <input type="hidden" name="token" value="{{token}}" />
  <label for="{{fields.password.id}}"
    >New password (12 to 128 characters)</label
  >
  <input
    id="{{fields.password.id}}"
    name="password"
    type="password"
    autocomplete="new-password"
    minlength="12"
    maxlength="128"
    required
    aria-invalid="{{fields.password.ariaInvalid}}"
  />
  <label for="{{fields.confirmation.id}}">Repeat the new password</label>
  <input
    id="{{fields.confirmation.id}}"
    name="confirmation"
    type="password"
    autocomplete="new-password"
    maxlength="128"
    required
    aria-invalid="{{fields.confirmation.ariaInvalid}}"
  />
  <button type="submit">Change password</button>
</form>
{{else}}
<p id="link-invalid">
  This reset link is invalid or has expired.
  <a href="/forgot-password">Request a new one</a>.
</p>
{{/if}}
