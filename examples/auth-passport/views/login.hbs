<h1>{{title}}</h1>
{{#if summary.hasErrors}}
<div
  id="form-summary"
  role="group"
  aria-labelledby="form-summary-title"
  tabindex="-1"
>
  <h2 id="form-summary-title">{{summary.title}}</h2>
  <ul>
    {{#each summary.items}}
    <li>{{message}}</li>
    {{/each}}
  </ul>
</div>
{{/if}}
<form id="login-form" method="post" action="/login" novalidate>
  <input type="hidden" name="_csrf" value="{{csrf}}" />
  <label for="{{fields.email.id}}">Email</label>
  <input
    id="{{fields.email.id}}"
    name="email"
    type="email"
    value="{{old.email}}"
    autocomplete="username"
    maxlength="254"
    required
    aria-invalid="{{fields.email.ariaInvalid}}"
  />
  <label for="{{fields.password.id}}">Password</label>
  <input
    id="{{fields.password.id}}"
    name="password"
    type="password"
    autocomplete="current-password"
    maxlength="128"
    required
    aria-invalid="{{fields.password.ariaInvalid}}"
  />
  <button type="submit">Sign in</button>
</form>
<p><a href="/forgot-password">Forgot your password?</a></p>
<p>
  Demo accounts (public password <code>demo-password-2026</code>):
  <code>ada@example.test</code> (admin), <code>max@example.test</code> (member).
</p>
