{
  "name": "@nestvexa/example-inertia-react",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p client/tsconfig.json && vite build && vite build --ssr client/ssr.tsx --outDir dist/ssr",
    "dev": "tsx src/main.ts --dev",
    "start": "node dist/main.js",
    "start:ssr": "node --env-file=ssr.production.env dist/ssr/ssr.js",
    "start:e2e": "node dist/main.js --test-controls"
  },
  "dependencies": {
    "@inertiajs/react": "3.10.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestvexa/inertia": "workspace:*",
    "@nestvexa/react": "workspace:*",
    "@nestvexa/vite": "workspace:*",
    "express-session": "1.19.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@inertiajs/core": "3.10.0",
    "@types/express-session": "1.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "vite": "8.3.5"
  }
}
