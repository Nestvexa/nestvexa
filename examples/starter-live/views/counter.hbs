<section aria-label="Counter">
  <p>
    Count: <output id="count" aria-live="polite">{{count}}</output>; double:
    <output id="double">{{doubled}}</output>
  </p>
  <button type="button" nv:click="increment" nv:loading.attr="disabled">
    Increment
  </button>
  <form nv:submit="save">
    <label
      >Name <input name="name" nv:model="name" maxlength="80" value="{{name}}"
    /></label>
    <button type="submit" nv:loading.attr="disabled">Save name</button>
    <p>Saved: <output id="saved" aria-live="polite">{{saved}}</output></p>
  </form>
  {{#if editorHidden}}
  <div id="focus-editor" hidden>
    <label for="focus-target">Focus target</label>
    {{#if editorDisabled}}
    <input id="focus-target" value="Local focus draft" disabled />
    {{else}}
    <input id="focus-target" value="Local focus draft" />
    {{/if}}
  </div>
  {{else}}
  <div id="focus-editor">
    <label for="focus-target">Focus target</label>
    {{#if editorDisabled}}
    <input id="focus-target" value="Local focus draft" disabled />
    {{else}}
    <input id="focus-target" value="Local focus draft" />
    {{/if}}
  </div>
  {{/if}}
  <button type="button" nv:click="disableEditor">Disable focus target</button>
  <button type="button" nv:click="hideEditor">Hide focus target</button>
  <section
    id="visibility-panel"
    nv:show="panelVisible"
    aria-label="Visibility focus example"
  >
    <label for="visibility-target">Visibility focus target</label>
    <input id="visibility-target" value="Local visibility draft" />
    <button type="button" nv:click="hidePanel">Hide visibility panel</button>
  </section>
  <section
    id="loading-panel"
    nv:loading.remove=""
    nv:target="slowPanel"
    aria-label="Loading focus example"
  >
    <label for="loading-target">Loading focus target</label>
    <input id="loading-target" value="Local loading draft" />
    <button type="button" nv:click="slowPanel">Run loading focus</button>
  </section>
  <div nv:ignore x-data="{ clicks: 0 }">
    <button type="button" x-on:click="clicks++">Local Alpine click</button>
    <output id="local" x-text="clicks">0</output>
    <button type="button" x-on:click="$live.call('increment')">
      Alpine server click
    </button>
  </div>
</section>
