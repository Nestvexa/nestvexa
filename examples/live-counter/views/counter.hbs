<section aria-label="Counter">
  <output id="count" aria-live="polite">{{count}}</output>
  <p>Double: <span id="double">{{doubled}}</span></p>
  <button type="button" nv:click="decrement">Decrease</button>
  <button type="button" nv:click="increment">Increase</button>
  <button
    type="button"
    nv:click="slow"
    nv:loading.attr="disabled"
    nv:target="slow"
  >
    Slow increase
  </button>
  <form nv:submit="save">
    <label for="name">Display name</label
    ><input id="name" nv:model="name" value="{{name}}" maxlength="80" />
    <button type="submit">Save name</button>
  </form>
  <p id="saved" nv:text="saved">{{saved}}</p>
  <p id="name-preview" nv:text="name" nv:bind="title:name" nv:cloak="">
    {{name}}
  </p>
  <p id="dirty-name" nv:dirty="name" hidden role="status">
    Unsaved display name
  </p>
  <a id="health-link" nv:bind="href:healthLink" href="/api/health"
    >Native health endpoint</a
  >
  <div id="visibility-area" nv:show="visible">
    <button type="button" nv:click="toggleVisible" nv:ref="toggle">
      Hide detail
    </button>
  </div>
  <button type="button" nv:click="toggleVisible">Toggle detail</button>
  <span nv:loading="" hidden role="status" aria-label="Live action status"
    >Updating…</span
  >
  <label for="changing-control">Changing input type</label>
  {{#if numericControl}}
  <input
    id="changing-control"
    type="number"
    value="12"
    nv:keydown.enter.prevent="toggleInputType"
  />
  {{else}}
  <input
    id="changing-control"
    type="text"
    value="12"
    nv:keydown.enter.prevent="toggleInputType"
  />
  {{/if}}
  <span
    id="loading-style"
    class="baseline"
    nv:loading.class="working"
    nv:target="slow"
    >Slow action status</span
  >
  <span id="increment-style" nv:loading.class="queued" nv:target="increment"
    >Increment action status</span
  >
  <span id="idle-status" nv:loading.remove="" nv:target="slow"
    >Ready for a slow action</span
  >
  <button
    id="server-disabled"
    type="button"
    disabled
    nv:loading.attr="disabled"
    nv:target="slow"
  >
    Unavailable server control
  </button>
  <section id="replace-children" nv:replace="" aria-label="Replace children">
    <h2>Replacement children</h2>
    <label for="replacement-note">Temporary replacement note</label
    ><input id="replacement-note" value="Server default" />
    <button type="button" nv:click="increment">
      Replace children increase
    </button>
    <output>{{count}}</output>
  </section>
  <section id="replace-self" nv:replace.self="" aria-label="Replace element">
    <h2>Replacement element</h2>
    <button type="button" nv:click="increment">Replace element increase</button
    ><output>{{count}}</output>
  </section>
  <section id="replace-alpine" nv:replace="" aria-label="Replaced Alpine">
    <h2>Replaced Alpine</h2>
    <div nv:ignore="" x-data="localCounter">
      <button type="button" x-on:click="incrementLocal">
        Replacement Alpine click</button
      ><output id="replacement-alpine-local" x-text="clicks">0</output>
    </div>
  </section>
  <section aria-label="Model synchronization">
    <h2>Model synchronization</h2>
    <label for="search">Live search</label
    ><input
      id="search"
      nv:model.live.debounce.100ms="search"
      value="{{search}}"
    />
    <output id="search-server">{{search}}</output>
    <label for="nickname">Blur nickname</label
    ><input id="nickname" nv:model.blur="nickname" value="{{nickname}}" />
    <output id="nickname-server">{{nickname}}</output>
    <label for="quantity">Quantity</label
    ><input
      id="quantity"
      nv:model.change.number="quantity"
      value="{{quantity}}"
    />
    <output id="quantity-server">{{quantity}}</output>
    <label for="enabled">Enabled</label
    ><select id="enabled" nv:model.change.boolean="enabled">
      {{#if enabled}}
      <option value="false">No</option>
      <option value="true" selected>Yes</option>
      {{else}}
      <option value="false" selected>No</option>
      <option value="true">Yes</option>
      {{/if}}
    </select>
    <output id="enabled-server">{{enabled}}</output>
    <fieldset>
      <legend>Color</legend>
      <label for="red">Red</label>{{#if (eq color "red")}}<input
        type="radio"
        id="red"
        name="color"
        value="red"
        nv:model.change="color"
        checked
      />{{else}}<input
        type="radio"
        id="red"
        name="color"
        value="red"
        nv:model.change="color"
      />{{/if}}<label for="blue">Blue</label>{{#if (eq color "blue")}}<input
        type="radio"
        id="blue"
        name="color"
        value="blue"
        nv:model.change="color"
        checked
      />{{else}}<input
        type="radio"
        id="blue"
        name="color"
        value="blue"
        nv:model.change="color"
      />{{/if}} {{#if allowGreen}}<label for="green">Green</label>{{#if (eq
      color "green")}}<input
        id="green"
        type="radio"
        name="color"
        value="green"
        nv:model.change="color"
        checked
      />{{else}}<input
        id="green"
        type="radio"
        name="color"
        value="green"
        nv:model.change="color"
      />{{/if}}{{/if}}
    </fieldset>
    <output id="color-server">{{color}}</output>
    <button type="button" nv:click="enableColorChoice">
      Enable green choice
    </button>
  </section>
  <section aria-label="Native form preservation">
    <h2>Native form preservation</h2>
    <form id="native-form" nv:submit="increment">
      <label for="native-note">Local note</label
      ><input id="native-note" name="note" value="{{nativeNote}}" />
      <label for="native-memo">Local memo</label
      ><textarea id="native-memo" name="memo">{{nativeMemo}}</textarea>
      <label for="native-priority">Local priority</label
      ><select id="native-priority" name="priority">
        {{#if nativeReverse}} {{#if (eq nativeChoice "high")}}
        <option id="priority-high" value="high" selected>High</option>
        {{else}}
        <option id="priority-high" value="high">High</option>
        {{/if}} {{#if (eq nativeChoice "low")}}
        <option id="priority-low" value="low" selected>Low</option>
        {{else}}
        <option id="priority-low" value="low">Low</option>
        {{/if}} {{else}} {{#if (eq nativeChoice "low")}}
        <option id="priority-low" value="low" selected>Low</option>
        {{else}}
        <option id="priority-low" value="low">Low</option>
        {{/if}} {{#if (eq nativeChoice "high")}}
        <option id="priority-high" value="high" selected>High</option>
        {{else}}
        <option id="priority-high" value="high">High</option>
        {{/if}} {{/if}}
      </select>
      <label for="native-labels">Local labels</label
      ><select id="native-labels" name="labels" multiple>
        {{#if nativeReset}}
        <option id="label-a" value="a">Alpha</option>
        <option id="label-b" value="b" selected>Beta</option>
        {{else}}
        <option id="label-a" value="a" selected>Alpha</option>
        <option id="label-b" value="b">Beta</option>
        {{/if}}
        <option id="label-c" value="c">Gamma</option>
      </select>
      <label for="native-flag">Local flag</label>{{#if nativeReset}}<input
        id="native-flag"
        type="checkbox"
        name="flag"
        checked
      />{{else}}<input id="native-flag" type="checkbox" name="flag" />{{/if}}
      <fieldset>
        <legend>Local tone</legend>
        <label for="tone-a">Tone A</label>{{#if nativeReset}}<input
          id="tone-a"
          type="radio"
          name="tone"
          value="a"
        />{{else}}<input
          id="tone-a"
          type="radio"
          name="tone"
          value="a"
          checked
        />{{/if}} <label for="tone-b">Tone B</label>{{#if nativeReset}}<input
          id="tone-b"
          type="radio"
          name="tone"
          value="b"
          checked
        />{{else}}<input
          id="tone-b"
          type="radio"
          name="tone"
          value="b"
        />{{/if}}
      </fieldset>
      <label for="native-file">Local attachment selection</label
      ><input id="native-file" type="file" name="attachment" />
      <button type="reset">Reset local form</button>
    </form>
    <fieldset>
      <legend>Unassociated native choices</legend>
      <p>These controls have no form owner; they share a native radio group.</p>
      <label for="ownerless-a">Unassociated A</label>{{#if nativeReset}}<input
        id="ownerless-a"
        type="radio"
        name="ownerless-choice"
        form="unavailable-form-a"
        value="a"
        checked
      />{{else}}<input
        id="ownerless-a"
        type="radio"
        name="ownerless-choice"
        form="unavailable-form-a"
        value="a"
      />{{/if}} <label for="ownerless-b">Unassociated B</label
      ><input
        id="ownerless-b"
        type="radio"
        name="ownerless-choice"
        form="unavailable-form-b"
        value="b"
      />
    </fieldset>
    <button type="button" nv:click="reorderNativeOptions">
      Reorder local options
    </button>
    <button type="button" nv:click="resetNativeDefaults">
      Change server defaults
    </button>
  </section>
  {{#*inline "self-widget-body"}}
  <h2>Widget wrapper with live children</h2>
  <button type="button" nv:click="increment">Wrapper increase</button>
  <output id="self-count" aria-live="polite">{{count}}</output>
  <label for="self-name">Widget author</label
  ><input id="self-name" nv:model="name" value="{{name}}" />
  <button type="button" nv:click="save">Save wrapper name</button>
  <span id="self-name-preview" nv:text="name">{{name}}</span>
  <button type="button" nv:click="slow">Delayed wrapper update</button>
  <span id="self-loading" nv:loading="" nv:target="slow" role="status"
    >Updating wrapper children</span
  >
  <div nv:ignore="">
    <label for="self-local">Wrapper local note</label
    ><input id="self-local" value="" />
  </div>
  {{/inline}} {{#if visible}}
  <section
    id="self-widget"
    nv:ignore.self=""
    class="server-wrapper-{{count}}"
    data-server-count="{{count}}"
    aria-label="Widget wrapper with live children"
  >
    {{> self-widget-body}}
  </section>
  {{else}}
  <section
    id="self-widget"
    class="server-wrapper-{{count}}"
    data-server-count="{{count}}"
    aria-label="Widget wrapper with live children"
  >
    {{> self-widget-body}}
  </section>
  {{/if}}
  <div id="local-widget" nv:ignore="">
    <label for="local-note">Independent local note</label
    ><input id="local-note" value="" />
  </div>
  <section
    id="alpine-widget"
    nv:ignore=""
    x-data="localCounter"
    aria-label="Alpine local widget"
  >
    <h2>Alpine local widget</h2>
    <button type="button" x-on:click="incrementLocal">
      Local Alpine click
    </button>
    <output id="alpine-local" x-text="clicks">0</output>
    <button type="button" x-on:click="incrementServer">
      Alpine server increment
    </button>
    <button type="button" x-on:click="renameServer">Alpine save name</button>
    <p>
      Server count from Alpine:
      <span id="alpine-server" x-text="$live.get('count')">0</span>
    </p>
  </section>
  <section aria-label="Event modifiers" id="event-parent">
    <h2>Event modifiers</h2>
    <button type="button" nv:click.once="increment">Once increase</button>
    <button type="button" nv:click.debounce.100ms="increment">
      Debounced increase
    </button>
    <button type="button" nv:click.throttle.500ms="increment">
      Throttled increase
    </button>
    <button type="button" nv:click.self="increment">
      <span id="self-child">Self increase</span>
    </button>
    <button type="button" nv:click.stop="increment">Stopped increase</button>
    <a href="/api/health" nv:click.prevent="increment">Prevented navigation</a>
    <label for="keyboard">Keyboard action</label
    ><input id="keyboard" nv:keydown.enter.prevent="increment" />
    <label for="shortcut">Control shortcut</label
    ><input id="shortcut" nv:keydown.ctrl.enter.prevent="increment" />
  </section>
</section>
