<section aria-label="Counter">
  <output id="count" aria-live="polite">{{count}}</output>
  <p>Double: <span id="double">{{doubled}}</span></p>
  <button type="button" nv:click="decrement">Decrease</button>
  <button type="button" nv:click="increment">Increase</button>
  <button
    type="button"
    nv:click="slow"
    nv:loading.attr="disabled"
    nv:target="slow"
  >
    Slow increase
  </button>
  <form nv:submit="save">
    <label for="name">Display name</label
    ><input id="name" nv:model="name" value="{{name}}" maxlength="80" />
    <button type="submit">Save name</button>
  </form>
  <p id="saved" nv:text="saved">{{saved}}</p>
  <p id="name-preview" nv:text="name" nv:bind="title:name" nv:cloak="">
    {{name}}
  </p>
  <p id="dirty-name" nv:dirty="name" hidden role="status">
    Unsaved display name
  </p>
  <a id="health-link" nv:bind="href:healthLink" href="/api/health"
    >Native health endpoint</a
  >
  <div id="visibility-area" nv:show="visible">
    <button type="button" nv:click="toggleVisible" nv:ref="toggle">
      Hide detail
    </button>
  </div>
  <button type="button" nv:click="toggleVisible">Toggle detail</button>
  <span nv:loading="" hidden role="status">Updating…</span>
  <label for="changing-control">Changing input type</label>
  {{#if numericControl}}
  <input
    id="changing-control"
    type="number"
    value="12"
    nv:keydown.enter.prevent="toggleInputType"
  />
  {{else}}
  <input
    id="changing-control"
    type="text"
    value="12"
    nv:keydown.enter.prevent="toggleInputType"
  />
  {{/if}}
  <span
    id="loading-style"
    class="baseline"
    nv:loading.class="working"
    nv:target="slow"
    >Slow action status</span
  >
  <span id="increment-style" nv:loading.class="queued" nv:target="increment"
    >Increment action status</span
  >
  <span id="idle-status" nv:loading.remove="" nv:target="slow"
    >Ready for a slow action</span
  >
  <button
    id="server-disabled"
    type="button"
    disabled
    nv:loading.attr="disabled"
    nv:target="slow"
  >
    Unavailable server control
  </button>
  <section id="replace-children" nv:replace="" aria-label="Replace children">
    <h2>Replacement children</h2>
    <label for="replacement-note">Temporary replacement note</label
    ><input id="replacement-note" value="Server default" />
    <button type="button" nv:click="increment">
      Replace children increase
    </button>
    <output>{{count}}</output>
  </section>
  <section id="replace-self" nv:replace.self="" aria-label="Replace element">
    <h2>Replacement element</h2>
    <button type="button" nv:click="increment">Replace element increase</button
    ><output>{{count}}</output>
  </section>
  <section id="replace-alpine" nv:replace="" aria-label="Replaced Alpine">
    <h2>Replaced Alpine</h2>
    <div nv:ignore="" x-data="localCounter">
      <button type="button" x-on:click="incrementLocal">
        Replacement Alpine click</button
      ><output id="replacement-alpine-local" x-text="clicks">0</output>
    </div>
  </section>
  <section aria-label="Model synchronization">
    <h2>Model synchronization</h2>
    <label for="search">Live search</label
    ><input
      id="search"
      nv:model.live.debounce.100ms="search"
      value="{{search}}"
    />
    <output id="search-server">{{search}}</output>
    <label for="nickname">Blur nickname</label
    ><input id="nickname" nv:model.blur="nickname" value="{{nickname}}" />
    <output id="nickname-server">{{nickname}}</output>
    <label for="quantity">Quantity</label
    ><input
      id="quantity"
      nv:model.change.number="quantity"
      value="{{quantity}}"
    />
    <output id="quantity-server">{{quantity}}</output>
    <label for="enabled">Enabled</label
    ><select id="enabled" nv:model.change.boolean="enabled">
      {{#if enabled}}
      <option value="false">No</option>
      <option value="true" selected>Yes</option>
      {{else}}
      <option value="false" selected>No</option>
      <option value="true">Yes</option>
      {{/if}}
    </select>
    <output id="enabled-server">{{enabled}}</output>
    <fieldset>
      <legend>Color</legend>
      <label for="red">Red</label>{{#if (eq color "red")}}<input
        type="radio"
        id="red"
        name="color"
        value="red"
        nv:model.change="color"
        checked
      />{{else}}<input
        type="radio"
        id="red"
        name="color"
        value="red"
        nv:model.change="color"
      />{{/if}}<label for="blue">Blue</label>{{#if (eq color "blue")}}<input
        type="radio"
        id="blue"
        name="color"
        value="blue"
        nv:model.change="color"
        checked
      />{{else}}<input
        type="radio"
        id="blue"
        name="color"
        value="blue"
        nv:model.change="color"
      />{{/if}}
    </fieldset>
    <output id="color-server">{{color}}</output>
  </section>
  <div id="local-widget" nv:ignore="">
    <label for="local-note">Independent local note</label
    ><input id="local-note" value="" />
  </div>
  <section
    id="alpine-widget"
    nv:ignore=""
    x-data="localCounter"
    aria-label="Alpine local widget"
  >
    <h2>Alpine local widget</h2>
    <button type="button" x-on:click="incrementLocal">
      Local Alpine click
    </button>
    <output id="alpine-local" x-text="clicks">0</output>
    <button type="button" x-on:click="incrementServer">
      Alpine server increment
    </button>
    <button type="button" x-on:click="renameServer">Alpine save name</button>
    <p>
      Server count from Alpine:
      <span id="alpine-server" x-text="$live.get('count')">0</span>
    </p>
  </section>
  <section aria-label="Event modifiers" id="event-parent">
    <h2>Event modifiers</h2>
    <button type="button" nv:click.once="increment">Once increase</button>
    <button type="button" nv:click.debounce.100ms="increment">
      Debounced increase
    </button>
    <button type="button" nv:click.throttle.500ms="increment">
      Throttled increase
    </button>
    <button type="button" nv:click.self="increment">
      <span id="self-child">Self increase</span>
    </button>
    <button type="button" nv:click.stop="increment">Stopped increase</button>
    <a href="/api/health" nv:click.prevent="increment">Prevented navigation</a>
    <label for="keyboard">Keyboard action</label
    ><input id="keyboard" nv:keydown.enter.prevent="increment" />
    <label for="shortcut">Control shortcut</label
    ><input id="shortcut" nv:keydown.ctrl.enter.prevent="increment" />
  </section>
</section>
