<section aria-labelledby="tenant-heading">
  <h2 id="tenant-heading">Tenant feed</h2>
  <p>Tenant: <output id="tenant">{{tenant}}</output></p>
  <p>Announcements in this tenant: <output id="notices">{{notices}}</output></p>
  <p>Sent from this component: <output id="sent">{{sent}}</output></p>
  <button type="button" nv:click="announce">Announce to my tenant</button>
</section>
