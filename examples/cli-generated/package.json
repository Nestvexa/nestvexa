{
  "name": "@nestvexa/example-cli-generated",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:client",
    "dev:react": "vite -c vite.react.config.ts",
    "build:react": "vite build -c vite.react.config.ts && vite build -c vite.react.config.ts --ssr client/react/ssr.tsx",
    "typecheck:react": "tsc -p client/react/tsconfig.json",
    "build:client": "pnpm run build:react && pnpm run build:vue && pnpm run build:svelte && pnpm run build:islands",
    "dev:vue": "vite -c vite.vue.config.ts",
    "build:vue": "vite build -c vite.vue.config.ts && vite build -c vite.vue.config.ts --ssr client/vue/ssr.ts",
    "typecheck:vue": "vue-tsc -p client/vue/tsconfig.json",
    "dev:svelte": "vite -c vite.svelte.config.ts",
    "build:svelte": "vite build -c vite.svelte.config.ts && vite build -c vite.svelte.config.ts --ssr client/svelte/ssr.ts",
    "typecheck:svelte": "svelte-check --tsconfig client/svelte/tsconfig.json --fail-on-warnings",
    "build:islands": "vite build -c vite.islands.config.ts",
    "typecheck:islands": "tsc -p client/islands/tsconfig.json",
    "start": "node dist/src/main.js"
  },
  "dependencies": {
    "@inertiajs/react": "3.10.0",
    "@inertiajs/svelte": "3.10.0",
    "@inertiajs/vue3": "3.10.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestvexa/actions": "workspace:*",
    "@nestvexa/engine-ejs": "workspace:*",
    "@nestvexa/engine-nunjucks": "workspace:*",
    "@nestvexa/engine-pug": "workspace:*",
    "@nestvexa/forms": "workspace:*",
    "@nestvexa/i18n": "workspace:*",
    "@nestvexa/inertia": "workspace:*",
    "@nestvexa/islands": "workspace:*",
    "@nestvexa/react": "workspace:*",
    "@nestvexa/realtime": "workspace:*",
    "@nestvexa/svelte": "workspace:*",
    "@nestvexa/uploads": "workspace:*",
    "@nestvexa/vite": "workspace:*",
    "@nestvexa/vue": "workspace:*",
    "express-session": "1.19.0",
    "nestvexa": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "svelte": "5.57.3",
    "vue": "3.5.44",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@inertiajs/core": "3.11.0",
    "@nestjs/testing": "12.2.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/express-session": "1.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-vue": "6.0.10",
    "prettier": "3.9.10",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.14"
  }
}
