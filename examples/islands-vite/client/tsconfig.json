{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "svelte", "node"],
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../src/island-definitions.ts",
    "../vite.islands.config.ts",
    "../vite.loader.config.ts"
  ]
}
