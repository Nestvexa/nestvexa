{
  "name": "@nestvexa/example-inertia-vue",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && vue-tsc -p client/tsconfig.json && vite build && vite build --ssr client/ssr.ts --outDir dist/ssr",
    "dev": "tsx src/main.ts --dev",
    "start": "node dist/main.js",
    "start:e2e": "node dist/main.js --test-controls",
    "start:csr": "node dist/main.js --test-controls --client-only"
  },
  "dependencies": {
    "@inertiajs/vue3": "3.10.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestvexa/forms": "workspace:*",
    "@nestvexa/inertia": "workspace:*",
    "@nestvexa/uploads": "workspace:*",
    "@nestvexa/vite": "workspace:*",
    "@nestvexa/vue": "workspace:*",
    "express-session": "1.19.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@inertiajs/core": "3.11.0",
    "@types/express-session": "1.19.0",
    "@vitejs/plugin-vue": "6.0.10",
    "tsx": "4.23.15",
    "vite": "8.3.5",
    "vue-tsc": "3.3.14"
  }
}
